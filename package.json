{
  "name": "nova-sportsbook",
  "version": "1.0.0",
  "private": true,
  "description": "NOVA SPORTSBOOK - production-grade sportsbook platform (frontend, betting engine, wallet, settlement, affiliate, admin)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "casino:diagnose": "node scripts/softaggregator-diagnose.mjs",
    "casino:reconcile": "node --import tsx scripts/casino-reconcile.mts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:sql": "bash scripts/run-sql-tests.sh",
    "worker:odds": "node --import tsx src/workers/entrypoints/odds.worker.ts",
    "worker:settlement": "node --import tsx src/workers/entrypoints/settlement.worker.ts",
    "worker:affiliate": "node --import tsx src/workers/entrypoints/affiliate.worker.ts",
    "worker:notification": "node --import tsx src/workers/entrypoints/notification.worker.ts",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:verify": "bash scripts/db-verify.sh",
    "preflight": "bash scripts/preflight-production.sh",
    "scan:secrets": "bash scripts/scan-service-role-exposure.sh",
    "i18n:check": "node scripts/i18n-check.mjs",
    "worker:crypto-payout": "node --import tsx src/workers/entrypoints/crypto-payout.worker.ts",
    "worker:odds-live": "node --import tsx src/workers/entrypoints/odds.worker.ts",
    "worker:payment": "node --import tsx src/workers/entrypoints/payment.worker.ts",
    "worker:logo": "node --import tsx src/workers/entrypoints/logo.worker.ts",
    "casino:readiness": "node --import tsx scripts/casino-readiness.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "@types/nodemailer": "^8.0.2",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.453.0",
    "next": "15.5.25",
    "nodemailer": "^10.0.13",
    "otplib": "^13.5.0",
    "pg": "^8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
