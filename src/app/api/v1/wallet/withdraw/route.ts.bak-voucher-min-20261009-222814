import { z } from 'zod';
import { ApiError, withErrorHandling, jsonCreated } from '@/lib/errors';
import { readJson, enforceRateLimit, idempotencyKeyFrom } from '@/server/http/request';
import { withUser } from '@/server/http/guard';
import { getUsdIrtRate, convertUsdMinorToIrrMinor, convertUsdMinorToIrtMinor } from '@/server/providers/arzhaam/client';

export const dynamic = 'force-dynamic';

const cryptoNetworks = {
  USDT: ['tron (trc-20)', 'ethereum (erc-20)', 'bnb smart chain (bep-20)', 'solana'],
  BTC: ['bitcoin'],
  ETH: ['ethereum (erc-20)'],
  TRX: ['tron (trc-20)'],
  XRP: ['xrp ledger'],
  ADA: ['cardano'],
  DOGE: ['dogecoin'],
} as const;

const cryptoAssets = ['USDT', 'BTC', 'ETH', 'TRX', 'XRP', 'ADA', 'DOGE'] as const;

const cryptoSchema = z.object({
  amountMinor: z.string().regex(/^\d{1,19}$/),
  currency: z.enum(['IRR', 'IRT', 'USD']),
  methodId: z.literal('crypto_withdrawal'),
  asset: z.enum(cryptoAssets),
  network: z.string().min(1).max(64),
  destination: z.string().min(4).max(120),
}).superRefine((value, ctx) => {
  const allowed = cryptoNetworks[value.asset] as readonly string[];
  if (!allowed.includes(value.network.trim().toLowerCase())) {
    ctx.addIssue({
      code: z.ZodIssueCode.custom,
      path: ['network'],
      message: `Unsupported ${value.asset} network`,
    });
  }
  if (BigInt(value.amountMinor) <= 0n) {
    ctx.addIssue({
      code: z.ZodIssueCode.custom,
      path: ['amountMinor'],
      message: 'Withdrawal amount must be greater than zero',
    });
  }
});

const voucherSchema = z.object({
  amountMinor: z.string().regex(/^\d{1,19}$/),
  currency: z.literal('USD'),
  methodId: z.enum(['voucher_uvoucher', 'voucher_hotvoucher']),
  email: z.string().trim().email().max(254),
}).superRefine((value, ctx) => {
  if (BigInt(value.amountMinor) < 100n) {
    ctx.addIssue({
      code: z.ZodIssueCode.custom,
      path: ['amountMinor'],
      message: 'Minimum voucher withdrawal is $1.00',
    });
  }
});

const schema = z.union([cryptoSchema, voucherSchema]);

export const POST = withErrorHandling(
  'wallet.withdraw',
  async (ctx, request: Request) => {
    const { services, user, actor } = await withUser(request, ctx);
    const idempotencyKey = idempotencyKeyFrom(request);
    await enforceRateLimit(`withdraw:${user.id}`, 5, 600);
    const body = await readJson(request, schema);

    if (body.methodId === 'crypto_withdrawal') {
      if (body.currency === 'USD') {
        if (BigInt(body.amountMinor) < 2000n) {
          throw new ApiError('BAD_REQUEST', 'Minimum crypto withdrawal is $20.00');
        }
      } else {
        const rate = await getUsdIrtRate();
        const minimumMinor = body.currency === 'IRT'
          ? convertUsdMinorToIrtMinor(2000n, rate.value)
          : convertUsdMinorToIrrMinor(2000n, rate.value);
        if (BigInt(body.amountMinor) < minimumMinor) {
          throw new ApiError('BAD_REQUEST', `Minimum crypto withdrawal is $20.00 equivalent in ${body.currency}`);
        }
      }

      const intent = await services.paymentsService.createWithdrawal({
        userId: user.id,
        amountMinor: BigInt(body.amountMinor),
        currency: body.currency,
        methodId: 'crypto_withdrawal',
        destination: body.destination,
        idempotencyKey,
        ip: null,
        providerMetadata: {
          asset: body.asset,
          network: body.network.trim().toLowerCase(),
          payoutCurrency: body.asset === 'USDT'
            ? ({
                'tron (trc-20)': 'usdttrc20',
                'ethereum (erc-20)': 'usdterc20',
                'bnb smart chain (bep-20)': 'usdtbsc',
                solana: 'usdtsol',
              } as Record<string, string>)[body.network.trim().toLowerCase()]
            : ({
                BTC: 'btc',
                ETH: 'eth',
                TRX: 'trx',
                XRP: 'xrp',
                ADA: 'ada',
                DOGE: 'doge',
              } as Record<string, string>)[body.asset],
          destination: body.destination,
        },
      });

      await services.admin.writeAudit({
        actorId: user.id,
        action: 'payment.withdrawal_requested',
        entityType: 'payment_intent',
        entityId: intent.publicId,
        after: {
          amountMinor: body.amountMinor,
          currency: body.currency,
          method: 'crypto_withdrawal',
          asset: body.asset,
          network: body.network.trim().toLowerCase(),
          destinationMasked: `${body.destination.slice(0, 4)}...${body.destination.slice(-4)}`,
        },
        reason: 'customer crypto withdrawal',
        correlationId: actor.correlationId,
      });

      return jsonCreated({ intent });
    }

    const requestedEmail = body.email.trim().toLowerCase();
    const atIndex = requestedEmail.indexOf('@');
    const localPart = requestedEmail.slice(0, atIndex);
    const domainPart = requestedEmail.slice(atIndex + 1);
    const destinationMasked = `${localPart.slice(0, 1)}***@${domainPart}`;

    const intent = await services.paymentsService.createWithdrawal({
      userId: user.id,
      amountMinor: BigInt(body.amountMinor),
      currency: 'USD',
      methodId: body.methodId,
      destination: requestedEmail,
      idempotencyKey,
      ip: null,
      providerMetadata: null,
    });

    await services.admin.writeAudit({
      actorId: user.id,
      action: 'payment.withdrawal_requested',
      entityType: 'payment_intent',
      entityId: intent.publicId,
      after: {
        amountMinor: body.amountMinor,
        currency: 'USD',
        method: body.methodId,
        destinationMasked,
      },
      reason: 'customer voucher withdrawal',
      correlationId: actor.correlationId,
    });

    return jsonCreated({ intent });
  },
);
