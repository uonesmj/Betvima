'use client';

import { useEffect, useMemo, useState } from 'react';
import { Activity, AlertTriangle, ArrowLeftRight, CircleDot, Flag, Goal, Hand, ScanLine, ShieldAlert, Target, Zap, Crosshair } from 'lucide-react';

type PitchEvent = {
  id: string;
  minute: number | null;
  type: string;
  playerName: string | null;
  detail: string | null;
  teamId?: string | null;
};

type Props = {
  homeName: string;
  awayName: string;
  homeLogo?: string | null;
  awayLogo?: string | null;
  homePressure: number;
  awayPressure: number;
  homeScore: number;
  awayScore: number;
  minute: number;
  latestEvent?: PitchEvent;
  isLive: boolean;
  status: string;
  homeTeamId?: string | null;
  awayTeamId?: string | null;
  events?: PitchEvent[];
};

function normalize(value: string) {
  return value.toLowerCase().replace(/[_-]/g, ' ').trim();
}

function eventKind(type?: string) {
  const value = normalize(type ?? '');
  if (value.includes('goal')) return 'goal';
  if (value.includes('red')) return 'red';
  if (value.includes('yellow')) return 'yellow';
  if (value.includes('substitut') || value.includes('player change')) return 'substitution';
  if (value.includes('offside')) return 'offside';
  if (value.includes('corner')) return 'corner';
  if (value.includes('penalty')) return 'penalty';
  if (value.includes('foul')) return 'foul';
  if (value.includes('save')) return 'save';
  if (value.includes('shot')) return 'shot';
  if (value.includes('miss')) return 'miss';
  return 'event';
}

function EventIcon({ kind }: { kind: string }) {
  if (kind === 'goal') return <Goal size={15} />;
  if (kind === 'shot' || kind === 'penalty') return <Target size={15} />;
  if (kind === 'corner') return <Flag size={15} />;
  if (kind === 'red') return <ShieldAlert size={15} />;
  if (kind === 'yellow') return <span className="h-4 w-3 rounded-[2px] border border-black/20 bg-[#F4C542] shadow-sm" />;
  if (kind === 'substitution') return <ArrowLeftRight size={15} />;
  if (kind === 'offside') return <ScanLine size={15} />;
  if (kind === 'foul') return <AlertTriangle size={15} />;
  if (kind === 'save') return <Hand size={15} />;
  if (kind === 'miss') return <Crosshair size={15} />;
  return <Activity size={15} />;
}

export function LivePitchVisualization({
  homeName,
  awayName,
  homeLogo,
  awayLogo,
  homePressure,
  awayPressure,
  homeScore,
  awayScore,
  minute,
  latestEvent,
  isLive,
  status,
  homeTeamId,
  awayTeamId,
  events = [],
}: Props) {
  const total = Math.max(1, homePressure + awayPressure);
  const homePct = Math.round((homePressure / total) * 100);
  const awayPct = 100 - homePct;
  const latestKind = eventKind(latestEvent?.type);
  const latestIsHome = Boolean(latestEvent?.teamId && homeTeamId && latestEvent.teamId === homeTeamId);
  const latestIsAway = Boolean(latestEvent?.teamId && awayTeamId && latestEvent.teamId === awayTeamId);
  const attackingEvent = ['goal', 'shot', 'penalty', 'miss', 'corner'].includes(latestKind);
  const ballX = attackingEvent && latestIsHome ? 82
    : attackingEvent && latestIsAway ? 18
    : latestIsHome ? 64
    : latestIsAway ? 36
    : Math.max(18, Math.min(82, homePct * 0.64 + 18));
  const kind = eventKind(latestEvent?.type);
  const [eventPulse, setEventPulse] = useState(false);
  const [previousEventId, setPreviousEventId] = useState<string | null>(null);

  useEffect(() => {
    if (!latestEvent?.id || latestEvent.id === previousEventId) return;
    const initialEvent = previousEventId === null;
    setPreviousEventId(latestEvent.id);
    if (initialEvent || !isLive) return;
    setEventPulse(true);
    const timer = window.setTimeout(() => setEventPulse(false), 1400);
    return () => window.clearTimeout(timer);
  }, [latestEvent?.id, previousEventId, isLive]);

  const pitchEvents = useMemo(() => {
    return events
      .filter((event) => normalize(event.type) !== 'period score')
      .slice(-10)
      .map((event, index) => {
        const kind = eventKind(event.type);
        const isHome = Boolean(event.teamId && homeTeamId && event.teamId === homeTeamId);
        const isAway = Boolean(event.teamId && awayTeamId && event.teamId === awayTeamId);
        const side = isHome ? 'home' : isAway ? 'away' : 'neutral';
        let x = isHome ? 30 + (index % 3) * 7 : isAway ? 70 - (index % 3) * 7 : 50 + ((index % 3) - 1) * 12;
        let y = 35 + (index % 3) * 15;

        if (['goal', 'shot', 'penalty', 'miss'].includes(kind)) {
          x = isHome ? 84 : isAway ? 16 : 50;
          y = kind === 'penalty' ? 50 : 35 + (index % 3) * 15;
        } else if (kind === 'corner') {
          x = isHome ? 88 : isAway ? 12 : (index % 2 ? 88 : 12);
          y = index % 2 ? 14 : 86;
        } else if (kind === 'offside') {
          x = isHome ? 70 : isAway ? 30 : 50;
          y = 30 + (index % 3) * 20;
        } else if (['foul', 'yellow', 'red'].includes(kind)) {
          x = (isHome ? 42 : isAway ? 58 : 50) + (index % 2 ? 7 : -7);
          y = 34 + (index % 3) * 16;
        }

        return {
          ...event, kind, side,
          x: Math.max(12, Math.min(88, x)),
          y: Math.max(16, Math.min(84, y)),
          isLatest: latestEvent?.id === event.id,
          size: kind === 'goal' ? 22 : ['red', 'yellow', 'corner', 'substitution'].includes(kind) ? 18 : 16,
        };
      });
  }, [events, homeTeamId, awayTeamId, latestEvent?.id]);

  const intensity = useMemo(
    () => Math.min(1, Math.max(homePressure, awayPressure) / 180),
    [homePressure, awayPressure],
  );

  return (
    <div className="relative mt-3 overflow-hidden rounded-[28px] border border-white/10 bg-[#0A1014] shadow-[0_25px_80px_rgba(0,0,0,.38)]">
      <style jsx>{`
        @keyframes eventBurst {
          0% { transform: translate(-50%, -50%) scale(.3); opacity: 0; }
          35% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
          100% { transform: translate(-50%, -50%) scale(1.8); opacity: 0; }
        }
        .event-burst { animation: eventBurst 1.1s ease-out both; }
      `}</style>

      <div className="flex items-center justify-between border-b border-white/8 px-3 py-2">
        <div className="flex min-w-0 items-center gap-2">
          <span className="relative grid h-2.5 w-2.5 place-items-center">
            {isLive && <span className="absolute h-2.5 w-2.5 animate-ping rounded-full bg-[#F04A63]/60" />}
            <span className={`relative h-1.5 w-1.5 rounded-full ${isLive ? 'bg-[#F04A63]' : 'bg-white/30'}`} />
          </span>
          <span className="text-[9px] font-black uppercase tracking-[.2em] text-white/45">
            Live visualization
          </span>
        </div>
        <div className="flex items-center gap-2">
          <span className="rounded-full bg-white/5 px-2 py-1 text-[8px] font-black uppercase tracking-[.12em] text-white/40">
            {/^(finished|complete|completed|ft)$/i.test(status) ? 'FULL TIME' : isLive ? (minute > 0 ? `${minute}'` : 'LIVE') : 'PRE MATCH'}
          </span>
          <span className="text-xs font-black tabular-nums text-white/85">
            {homeScore} : {awayScore}
          </span>
        </div>
      </div>

      <div className="relative p-2 sm:p-4">
        <div className="relative aspect-[2.4/1] sm:aspect-[1.9/1] overflow-hidden rounded-[22px] border border-white/12 bg-[linear-gradient(135deg,#123D2A,#17633D_50%,#0F4A2F)] shadow-[inset_0_0_70px_rgba(0,0,0,.28)]">
          <div className="pointer-events-none absolute inset-0 opacity-[.10]">
            <div className="absolute inset-0 bg-[repeating-linear-gradient(90deg,transparent_0%,transparent_9%,rgba(255,255,255,.5)_9.2%,transparent_9.5%,transparent_20%)]" />
          </div>

          <div className="pointer-events-none absolute inset-[7%] border border-white/55" />
          <div className="pointer-events-none absolute left-1/2 top-[7%] h-[86%] w-px -translate-x-1/2 bg-white/55" />
          <div className="pointer-events-none absolute left-1/2 top-1/2 h-[25%] aspect-square -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/55" />
          <div className="pointer-events-none absolute left-1/2 top-1/2 h-1.5 w-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white" />

          <div className="pointer-events-none absolute left-[7%] top-[27%] h-[46%] w-[13%] border border-white/55 border-l-0" />
          <div className="pointer-events-none absolute right-[7%] top-[27%] h-[46%] w-[13%] border border-white/55 border-r-0" />
          <div className="pointer-events-none absolute left-[7%] top-[37%] h-[26%] w-[5%] border border-white/45 border-l-0" />
          <div className="pointer-events-none absolute right-[7%] top-[37%] h-[26%] w-[5%] border border-white/45 border-r-0" />



          <div
            className="absolute top-1/2 z-20 transition-[left] duration-700 ease-out"
            style={{ left: `${ballX}%` }}
          >
            <div className="relative grid h-7 w-7 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-white bg-[#F7F8F9] text-[#101820] shadow-[0_3px_12px_rgba(0,0,0,.35)]">
              <CircleDot size={13} strokeWidth={2.5} />
            </div>
          </div>

          {pitchEvents.map((event) => (
            <div
              key={event.id}
              className="absolute z-10 -translate-x-1/2 -translate-y-1/2"
              style={{ left: `${event.x}%`, top: `${event.y}%` }}
              title={`${event.minute ?? '—'}' ${event.type.replace(/[_-]/g, ' ')}${event.playerName ? ` · ${event.playerName}` : ''}`}
            >
              {event.isLatest && eventPulse && (
                <span className="absolute left-1/2 top-1/2 h-10 w-10 -translate-x-1/2 -translate-y-1/2 animate-ping rounded-full border border-white/40" />
              )}
              <span
                className={`grid place-items-center rounded-full border shadow-[0_4px_18px_rgba(0,0,0,.38)] ${
                  event.kind === 'goal'
                    ? 'border-white bg-[#F04A63] text-white'
                    : event.kind === 'red'
                      ? 'border-white bg-[#D93651] text-white'
                      : event.kind === 'yellow'
                        ? 'border-[#F4C542] bg-[#F4C542] text-[#111820]'
                        : event.kind === 'corner'
                          ? 'border-white/70 bg-[#172128] text-white'
                          : 'border-white/45 bg-black/35 text-white'
                }`}
                style={{ width: event.size, height: event.size }}
              >
                <EventIcon kind={event.kind} />
              </span>
            </div>
          ))}


          <div className="absolute left-[5%] top-[8%] flex items-center gap-1.5 rounded-full border border-white/15 bg-black/25 px-2 py-1 backdrop-blur">
            {homeLogo ? (
              <img src={homeLogo} alt="" className="h-5 w-5 object-contain" />
            ) : (
              <span className="grid h-5 w-5 place-items-center rounded-full bg-white/15 text-[8px] font-black text-white">
                {homeName.slice(0, 1)}
              </span>
            )}
            <span className="hidden max-w-[110px] truncate text-[8px] font-black text-white/75 sm:block">
              {homeName}
            </span>
          </div>

          <div className="absolute right-[5%] top-[8%] flex items-center gap-1.5 rounded-full border border-white/15 bg-black/25 px-2 py-1 backdrop-blur">
            <span className="hidden max-w-[110px] truncate text-[8px] font-black text-white/75 sm:block">
              {awayName}
            </span>
            {awayLogo ? (
              <img src={awayLogo} alt="" className="h-5 w-5 object-contain" />
            ) : (
              <span className="grid h-5 w-5 place-items-center rounded-full bg-white/15 text-[8px] font-black text-white">
                {awayName.slice(0, 1)}
              </span>
            )}
          </div>
        </div>

        <div className="mt-3 grid grid-cols-[1fr_auto_1fr] items-center gap-2">
          <div>
            <div className="mb-1 flex items-center justify-between">
              <span className="truncate text-[8px] font-black uppercase tracking-[.1em] text-white/35">
                {homeName}
              </span>
              <span className="text-[10px] font-black tabular-nums text-white/70">{homePct}%</span>
            </div>
            <div className="h-1.5 overflow-hidden rounded-full bg-white/8">
              <div className="h-full rounded-full bg-white/75 transition-all duration-1000" style={{ width: `${homePct}%` }} />
            </div>
          </div>
          <div className="flex items-center gap-1 rounded-full border border-white/8 bg-white/5 px-2.5 py-1.5 text-[8px] font-black uppercase tracking-[.12em] text-white/35">
            <Zap size={10} />
            Momentum
          </div>
          <div>
            <div className="mb-1 flex items-center justify-between">
              <span className="text-[10px] font-black tabular-nums text-white/70">{awayPct}%</span>
              <span className="truncate text-[8px] font-black uppercase tracking-[.1em] text-white/35">{awayName}</span>
            </div>
            <div className="h-1.5 overflow-hidden rounded-full bg-white/8">
              <div className="ml-auto h-full rounded-full bg-white/35 transition-all duration-1000" style={{ width: `${awayPct}%` }} />
            </div>
          </div>
        </div>

        {latestEvent && (
          <div className="mt-3 flex items-center gap-2 rounded-2xl border border-white/8 bg-white/[.04] px-3 py-2.5">
            <div className="grid h-7 w-7 shrink-0 place-items-center rounded-xl bg-white/8 text-white/70">
              <EventIcon kind={kind} />
            </div>
            <div className="min-w-0 flex-1">
              <div className="text-[8px] font-black uppercase tracking-[.14em] text-white/30">
                Latest event
              </div>
              <div className="truncate text-[10px] font-bold text-white/75">
                {latestEvent.type.replace(/[_-]/g, ' ')}
                {latestEvent.playerName ? ` · ${latestEvent.playerName}` : ''}
              </div>
            </div>
            <span className="text-[9px] font-black tabular-nums text-white/40">
              {latestEvent.minute != null ? `${latestEvent.minute}'` : '—'}
            </span>
          </div>
        )}
      </div>
    </div>
  );
}
