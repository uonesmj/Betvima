'use client';

import { useEffect, useMemo, useRef, useState } from 'react';
import { Activity, AlertTriangle, ArrowLeftRight, CircleDot, Flag, Goal, Hand, ScanLine, ShieldAlert, Target, Zap, Crosshair } from 'lucide-react';

type PitchEvent = {
  id: string;
  minute: number | null;
  type: string;
  playerName: string | null;
  detail: string | null;
  teamId?: string | null;
};

type Props = {
  homeName: string;
  awayName: string;
  homeLogo?: string | null;
  awayLogo?: string | null;
  homePressure: number;
  awayPressure: number;
  possessionHome: number;
  possessionAway: number;
  attacksHome: number;
  attacksAway: number;
  dangerousHome: number;
  dangerousAway: number;
  homeScore: number;
  awayScore: number;
  minute: number;
  latestEvent?: PitchEvent;
  isLive: boolean;
  status: string;
  homeTeamId?: string | null;
  awayTeamId?: string | null;
  events?: PitchEvent[];
};

function normalize(value: string) {
  return value.toLowerCase().replace(/[_-]/g, ' ').trim();
}

function eventKind(type?: string) {
  const value = normalize(type ?? '');
  if (value.includes('goal')) return 'goal';
  if (value.includes('red')) return 'red';
  if (value.includes('yellow')) return 'yellow';
  if (value.includes('substitut') || value.includes('player change')) return 'substitution';
  if (value.includes('offside')) return 'offside';
  if (value.includes('corner')) return 'corner';
  if (value.includes('penalty')) return 'penalty';
  if (value.includes('foul')) return 'foul';
  if (value.includes('save')) return 'save';
  if (value.includes('shot')) return 'shot';
  if (value.includes('miss')) return 'miss';
  return 'event';
}

function EventIcon({ kind }: { kind: string }) {
  if (kind === 'goal') return <Goal size={15} />;
  if (kind === 'shot' || kind === 'penalty') return <Target size={15} />;
  if (kind === 'corner') return <Flag size={15} />;
  if (kind === 'red') return <ShieldAlert size={15} />;
  if (kind === 'yellow') return <span className="h-4 w-3 rounded-[2px] border border-black/20 bg-[#F4C542] shadow-sm" />;
  if (kind === 'substitution') return <ArrowLeftRight size={15} />;
  if (kind === 'offside') return <ScanLine size={15} />;
  if (kind === 'foul') return <AlertTriangle size={15} />;
  if (kind === 'save') return <Hand size={15} />;
  if (kind === 'miss') return <Crosshair size={15} />;
  return <Activity size={15} />;
}


const FORMATION: Array<[number, number]> = [
  [8,50],[21,20],[21,40],[21,60],[21,80],
  [38,30],[38,50],[38,70],[56,25],[56,50],[56,75],
];
export function LivePitchVisualization({
  homeName,
  awayName,
  homeLogo,
  awayLogo,
  homePressure,
  awayPressure,
  possessionHome,
  possessionAway,
  attacksHome,
  attacksAway,
  dangerousHome,
  dangerousAway,
  homeScore,
  awayScore,
  minute,
  isLive,
  status,
  events = [],
}: Props) {
  const pressureTotal = Math.max(1, homePressure + awayPressure);
  const possessionTotal = Math.max(0, possessionHome) + Math.max(0, possessionAway);
  const attackHome = Math.max(0, attacksHome) + Math.max(0, dangerousHome) * 1.8;
  const attackAway = Math.max(0, attacksAway) + Math.max(0, dangerousAway) * 1.8;
  const attackTotal = Math.max(1, attackHome + attackAway);
  const homePct = Math.round(Math.max(0, Math.min(100,
    possessionTotal > 0
      ? (Math.max(0, possessionHome) / possessionTotal) * 100
      : attackHome + attackAway > 0
        ? (attackHome / attackTotal) * 100
        : (homePressure / pressureTotal) * 100
  )));
  const awayPct = 100 - homePct;
  const homeThreatShare = attackHome / attackTotal;
  const homePush = homeThreatShare * 7;
  const awayPush = (1 - homeThreatShare) * 7;

  // Advance the ball between player positions while the match is live.
  const [ballStep, setBallStep] = useState(0);
  useEffect(() => {
    if (!isLive) return;
    const timer = window.setInterval(() => setBallStep((n) => n + 1), 1700);
    return () => window.clearInterval(timer);
  }, [isLive]);
  // Simulated passing: target the exact rendered position of a player.
  // Possession share influences which side receives the next pass.
  const homePassSlots = Math.max(1, Math.min(9, Math.round(homePct / 10)));
  const possessionSlot = ballStep % 10;
  const homePossesses = possessionSlot < homePassSlots;
  const passIndex = Math.floor(ballStep / 1) % FORMATION.length;
  // Deterministic visual movement: preserve each team's formation while
  // players adjust their positions smoothly as the simulated play advances.
  const getPlayerPosition = (index: number, team: 'home' | 'away', step: number): [number, number] => {
    const [baseX, baseY] = FORMATION[index] ?? [50, 50];
    const phase = step * 0.42;
    const driftX = Math.sin(phase + index * 0.91 + (team === 'away' ? 1.4 : 0)) * 2.6;
    const driftY = Math.cos(step * 0.36 + index * 1.17 + (team === 'away' ? 0.8 : 0)) * 4.2;
    if (team === 'home') {
      return [
        Math.max(5, Math.min(65, baseX + homePush + driftX)),
        Math.max(10, Math.min(90, baseY + driftY)),
      ];
    }
    return [
      Math.max(35, Math.min(95, 100 - baseX - awayPush + driftX)),
      Math.max(10, Math.min(90, 100 - baseY + driftY)),
    ];
  };
  const [ballX, ballY] = getPlayerPosition(passIndex, homePossesses ? 'home' : 'away', ballStep);

  // Ignore the initially loaded event history; enqueue new IDs only once.
  const seenEventIds = useRef<Set<string>>(new Set());
  const eventsInitialized = useRef(false);
  const [popupQueue, setPopupQueue] = useState<PitchEvent[]>([]);
  const activePopup = popupQueue[0] ?? null;
  const activePopupId = activePopup?.id;
  const [popupClosing, setPopupClosing] = useState(false);

  useEffect(() => {
    const seen = seenEventIds.current;

    // Seed the initial snapshot so historical events are never replayed.
    if (!eventsInitialized.current) {
      if (events.length > 0) {
        for (const event of events) {
          if (event.id) seen.add(event.id);
        }
        eventsInitialized.current = true;
      }
      return;
    }

    // Mark every new event as seen, but display only the newest event
    // from this update. Never queue old events for later popups.
    const fresh = events.filter((event) =>
      event.id &&
      normalize(event.type) !== 'period score' &&
      !seen.has(event.id)
    );

    for (const event of fresh) seen.add(event.id);

    const newestEvent = fresh.at(-1);
    if (newestEvent && isLive) {
      setPopupQueue([newestEvent]);
    }
  }, [events, isLive]);

  useEffect(() => {
    if (!activePopupId) return;
    setPopupClosing(false);
    const fadeTimer = window.setTimeout(() => setPopupClosing(true), 3100);
    const removeTimer = window.setTimeout(() => {
      setPopupQueue((queue) => queue[0]?.id === activePopupId ? queue.slice(1) : queue);
    }, 3500);
    return () => {
      window.clearTimeout(fadeTimer);
      window.clearTimeout(removeTimer);
    };
  }, [activePopupId]);

  const intensity = useMemo(
    () => Math.min(1, Math.max(homePressure, awayPressure) / 180),
    [homePressure, awayPressure],
  );

  return (
    <div className="relative mt-3 overflow-hidden rounded-[28px] border border-white/10 bg-[#0A1014] shadow-[0_25px_80px_rgba(0,0,0,.38)]">
      <style jsx>{`
        @keyframes eventBurst {
          0% { transform: translate(-50%, -50%) scale(.3); opacity: 0; }
          35% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
          100% { transform: translate(-50%, -50%) scale(1.8); opacity: 0; }
        }
        .event-burst { animation: eventBurst 1.1s ease-out both; }
      `}</style>

      <div className="flex items-center justify-between border-b border-white/8 px-3 py-2">
        <div className="flex min-w-0 items-center gap-2">
          <span className="relative grid h-2.5 w-2.5 place-items-center">
            {isLive && <span className="absolute h-2.5 w-2.5 animate-ping rounded-full bg-[#F04A63]/60" />}
            <span className={`relative h-1.5 w-1.5 rounded-full ${isLive ? 'bg-[#F04A63]' : 'bg-white/30'}`} />
          </span>
          <span className="text-[9px] font-black uppercase tracking-[.2em] text-white/45">
            Live visualization
          </span>
        </div>
        <div className="flex items-center gap-2">
          <span className="rounded-full bg-white/5 px-2 py-1 text-[8px] font-black uppercase tracking-[.12em] text-white/40">
            {/^(finished|complete|completed|ft)$/i.test(status) ? 'FULL TIME' : isLive ? (minute > 0 ? `${minute}'` : 'LIVE') : 'PRE MATCH'}
          </span>
          <span className="text-xs font-black tabular-nums text-white/85">
            {homeScore} : {awayScore}
          </span>
        </div>
      </div>

      <div className="relative p-2 sm:p-4">
        <div className="relative aspect-[2.4/1] sm:aspect-[1.9/1] overflow-hidden rounded-[22px] border border-white/12 bg-[linear-gradient(135deg,#123D2A,#17633D_50%,#0F4A2F)] shadow-[inset_0_0_70px_rgba(0,0,0,.28)]">
          <div className="pointer-events-none absolute inset-0 opacity-[.10]">
            <div className="absolute inset-0 bg-[repeating-linear-gradient(90deg,transparent_0%,transparent_9%,rgba(255,255,255,.5)_9.2%,transparent_9.5%,transparent_20%)]" />
          </div>

          <div className="pointer-events-none absolute inset-[7%] border border-white/55" />
          <div className="pointer-events-none absolute left-1/2 top-[7%] h-[86%] w-px -translate-x-1/2 bg-white/55" />
          <div className="pointer-events-none absolute left-1/2 top-1/2 h-[25%] aspect-square -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/55" />
          <div className="pointer-events-none absolute left-1/2 top-1/2 h-1.5 w-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white" />

          <div className="pointer-events-none absolute left-[7%] top-[27%] h-[46%] w-[13%] border border-white/55 border-l-0" />
          <div className="pointer-events-none absolute right-[7%] top-[27%] h-[46%] w-[13%] border border-white/55 border-r-0" />
          <div className="pointer-events-none absolute left-[7%] top-[37%] h-[26%] w-[5%] border border-white/45 border-l-0" />
          <div className="pointer-events-none absolute right-[7%] top-[37%] h-[26%] w-[5%] border border-white/45 border-r-0" />



          {FORMATION.map((_, i) => {
            const [x, y] = getPlayerPosition(i, 'home', ballStep);
            return (
              <span key={`home-player-${i}`} aria-label={`${homeName}, player ${i + 1}`}
                className="absolute z-[5] grid h-4 w-4 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-white bg-sky-300 text-[7px] font-black text-slate-900 shadow-md transition-[left,top] duration-[1500ms] ease-in-out"
                style={{ left: `${x}%`, top: `${y}%` }}>{i + 1}</span>
            );
          })}
          {FORMATION.map((_, i) => {
            const [x, y] = getPlayerPosition(i, 'away', ballStep);
            return (
              <span key={`away-player-${i}`} aria-label={`${awayName}, player ${i + 1}`}
                className="absolute z-[5] grid h-4 w-4 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-white bg-rose-400 text-[7px] font-black text-white shadow-md transition-[left,top] duration-[1500ms] ease-in-out"
                style={{ left: `${x}%`, top: `${y}%` }}>{i + 1}</span>
            );
          })}
          <div
            className="absolute z-20 transition-[left,top] duration-[1500ms] ease-in-out"
            style={{ left: `${ballX}%`, top: `${ballY}%` }}
          >
            <div className="relative grid h-7 w-7 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-white bg-[#F7F8F9] text-[#101820] shadow-[0_3px_12px_rgba(0,0,0,.35)]">
              <CircleDot size={13} strokeWidth={2.5} />
            </div>
          </div>

          {activePopup && (
            <div role="status" aria-live="polite"
              className="absolute left-1/2 top-1/2 z-30 w-[min(88%,340px)] transition-all duration-300"
              style={{
                transform: popupClosing ? 'translate(-50%, -70%)' : 'translate(-50%, -50%)',
                opacity: popupClosing ? 0 : 1,
              }}>
              <div className={`flex items-center gap-3 rounded-2xl border px-4 py-3 shadow-2xl backdrop-blur-md ${
                eventKind(activePopup.type) === 'goal' ? 'border-emerald-300/60 bg-emerald-950/95 text-white'
                : eventKind(activePopup.type) === 'red' ? 'border-rose-300/60 bg-rose-950/95 text-white'
                : eventKind(activePopup.type) === 'yellow' ? 'border-amber-300/60 bg-amber-950/95 text-white'
                : 'border-white/20 bg-[#101A20]/95 text-white'
              }`}>
                <span className="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-white/10">
                  <EventIcon kind={eventKind(activePopup.type)} />
                </span>
                <span className="min-w-0 flex-1">
                  <span className="block text-[10px] font-black uppercase tracking-[.16em] opacity-65">
                    {activePopup.minute == null ? 'LIVE EVENT' : `${activePopup.minute}' · LIVE EVENT`}
                  </span>
                  <span className="mt-1 block truncate text-sm font-extrabold">
                    {activePopup.type.replace(/[_-]/g, ' ')}
                  </span>
                  {activePopup.playerName && <span className="block truncate text-xs opacity-75">{activePopup.playerName}</span>}
                  {activePopup.detail && <span className="block truncate text-xs opacity-65">{activePopup.detail}</span>}
                </span>
              </div>
            </div>
          )}
          <div className="absolute left-[5%] top-[8%] flex items-center gap-1.5 rounded-full border border-white/15 bg-black/25 px-2 py-1 backdrop-blur">
            {homeLogo ? (
              <img src={homeLogo} alt="" className="h-5 w-5 object-contain" />
            ) : (
              <span className="grid h-5 w-5 place-items-center rounded-full bg-white/15 text-[8px] font-black text-white">
                {homeName.slice(0, 1)}
              </span>
            )}
            <span className="hidden max-w-[110px] truncate text-[8px] font-black text-white/75 sm:block">
              {homeName}
            </span>
          </div>

          <div className="absolute right-[5%] top-[8%] flex items-center gap-1.5 rounded-full border border-white/15 bg-black/25 px-2 py-1 backdrop-blur">
            <span className="hidden max-w-[110px] truncate text-[8px] font-black text-white/75 sm:block">
              {awayName}
            </span>
            {awayLogo ? (
              <img src={awayLogo} alt="" className="h-5 w-5 object-contain" />
            ) : (
              <span className="grid h-5 w-5 place-items-center rounded-full bg-white/15 text-[8px] font-black text-white">
                {awayName.slice(0, 1)}
              </span>
            )}
          </div>
        </div>

        <div className="mt-3 grid grid-cols-[1fr_auto_1fr] items-center gap-2">
          <div>
            <div className="mb-1 flex items-center justify-between">
              <span className="truncate text-[8px] font-black uppercase tracking-[.1em] text-white/35">
                {homeName}
              </span>
              <span className="text-[10px] font-black tabular-nums text-white/70">{homePct}%</span>
            </div>
            <div className="h-1.5 overflow-hidden rounded-full bg-white/8">
              <div className="h-full rounded-full bg-white/75 transition-all duration-1000" style={{ width: `${homePct}%` }} />
            </div>
          </div>
          <div className="flex items-center gap-1 rounded-full border border-white/8 bg-white/5 px-2.5 py-1.5 text-[8px] font-black uppercase tracking-[.12em] text-white/35">
            <Zap size={10} />
            Momentum
          </div>
          <div>
            <div className="mb-1 flex items-center justify-between">
              <span className="text-[10px] font-black tabular-nums text-white/70">{awayPct}%</span>
              <span className="truncate text-[8px] font-black uppercase tracking-[.1em] text-white/35">{awayName}</span>
            </div>
            <div className="h-1.5 overflow-hidden rounded-full bg-white/8">
              <div className="ml-auto h-full rounded-full bg-white/35 transition-all duration-1000" style={{ width: `${awayPct}%` }} />
            </div>
          </div>
        </div>


      </div>
    </div>
  );
}
