            </div>

            <div className="mt-3 grid gap-3 sm:grid-cols-2">
              <div className="rounded-2xl border border-[#E5E8EC] bg-white p-4">
                <div className="mb-3 text-[9px] font-black uppercase tracking-[.15em] text-[#858C95]">
                  Discipline
                </div>
                <div className="grid grid-cols-2 gap-2">
                  <div className="rounded-xl bg-[#FFF8E8] p-3">
                    <div className="text-[9px] font-bold text-[#9B762A]">
                      Yellow cards
                    </div>
                    <div className="mt-1 text-xl font-black text-[#282D33]">
                      {stats.yellowHome} — {stats.yellowAway}
                    </div>
                  </div>
                  <div className="rounded-xl bg-[#FFF0F2] p-3">
                    <div className="text-[9px] font-bold text-[#B63C50]">
                      Red cards
                    </div>
                    <div className="mt-1 text-xl font-black text-[#282D33]">
                      {stats.redHome} — {stats.redAway}
                    </div>
                  </div>
                </div>
              </div>

              <div className="rounded-2xl border border-[#E5E8EC] bg-white p-4">
                <div className="mb-3 text-[9px] font-black uppercase tracking-[.15em] text-[#858C95]">
                  Data source
                </div>
                <div className="flex items-center justify-between">
                  <div>
                    <div className="text-xs font-black text-[#252A30]">
                      {liveStats?.provider ?? 'Live provider'}
                    </div>
                    <div className="mt-1 text-[9px] text-[#949BA3]">
                      {liveStats?.updatedAt
                        ? formatExactDate(liveStats.updatedAt)
                        : 'Waiting for live update'}
                    </div>
                  </div>
                  <div className="grid h-10 w-10 place-items-center rounded-xl bg-[#EEF2F5]">
                    <Radio size={17} className="text-[#606871]" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div className="h-full w-full min-w-full shrink-0 snap-start overflow-y-auto bg-white px-3 py-3 sm:px-7 sm:py-5">
          <div className="mx-auto max-w-[920px]">
            <div className="mb-3 flex items-center justify-between">
              <div>
                <div className="text-[9px] font-black uppercase tracking-[.2em] text-[#9AA1A9]">
                  Match timeline
                </div>
                <h3 className="mt-1 text-lg font-black text-[#20242A]">
                  Live events
                </h3>
              </div>
              <span className="rounded-full bg-[#F1F3F5] px-3 py-1.5 text-[9px] font-black text-[#737B84]">
                {liveEvents.length} events
              </span>
            </div>

            {liveEvents.length > 0 ? (
              <div className="relative">
                <div className="absolute bottom-2 left-[23px] top-2 w-px bg-[#E4E7EA]" />

                <div className="space-y-2">
                  {[...liveEvents].reverse().map((event, index) => (
                    <div
                      key={event.id}
                      className={`event-in relative flex items-center gap-3 rounded-2xl border border-[#E8EAED] bg-white px-3 py-3 shadow-[0_3px_12px_rgba(20,27,34,.035)] ${
                        index === 0 ? 'ring-1 ring-[#E1E5E8]' : ''
                      }`}
                      style={{ animationDelay: `${index * 45}ms` }}
                    >
                      <div className="relative z-10 grid h-8 w-8 shrink-0 place-items-center rounded-full border border-[#E4E7EA] bg-white text-[#5D6670]">
                        {eventIcon(event.type)}
                      </div>

                      <div className="min-w-0 flex-1">
                        <div className="flex flex-wrap items-center gap-2">
                          <span className="text-[11px] font-black text-[#252A30]">
                            {eventLabel(event.type)}
                          </span>
                          {event.playerName && (
                            <span className="text-[10px] font-semibold text-[#858C95]">
                              {event.playerName}
                            </span>
                          )}
                        </div>

                        {event.detail && (
                          <div className="mt-0.5 truncate text-[9px] text-[#9AA1A9]">
                            {event.detail}
                          </div>
                        )}
                      </div>

                      <div className="shrink-0 rounded-lg bg-[#F3F5F7] px-2 py-1 text-[10px] font-black tabular-nums text-[#555E67]">
                        {event.minute != null ? `${event.minute}'` : '—'}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ) : (
              <div className="rounded-2xl border border-dashed border-[#DDE1E6] bg-[#F8F9FA] px-5 py-12 text-center">
                <Activity size={22} className="mx-auto text-[#A0A6AD]" />
                <div className="mt-3 text-xs font-black text-[#606871]">
                  No live events yet
                </div>
                <div className="mt-1 text-[10px] text-[#9AA1A9]">
                  Events will appear here as the live provider reports them.
                </div>
              </div>
            )}

            <div className="mt-4 grid gap-3 sm:grid-cols-3">
              <div className="rounded-2xl bg-[#F8F9FA] p-4">
                <div className="text-[9px] font-black uppercase tracking-[.14em] text-[#8B929A]">
                  Goals
                </div>
                <div className="mt-1 text-xl font-black text-[#20242A]">
                  {match.homeScore ?? 0} — {match.awayScore ?? 0}
                </div>
              </div>

              <div className="rounded-2xl bg-[#F8F9FA] p-4">
                <div className="text-[9px] font-black uppercase tracking-[.14em] text-[#8B929A]">
                  Corners
                </div>
                <div className="mt-1 text-xl font-black text-[#20242A]">
                  {stats.cornersHome} — {stats.cornersAway}
                </div>
              </div>

              <div className="rounded-2xl bg-[#F8F9FA] p-4">
                <div className="text-[9px] font-black uppercase tracking-[.14em] text-[#8B929A]">
                  Discipline
                </div>
                <div className="mt-1 text-xl font-black text-[#20242A]">
                  {stats.yellowHome + stats.redHome} —{' '}
                  {stats.yellowAway + stats.redAway}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div className="flex items-center justify-center gap-2 border-t border-[#E5E8EC] bg-white px-4 py-3">
        <button
          type="button"
          onClick={() => scrollToSlide(Math.max(0, slide - 1))}
          disabled={slide === 0}
          className="grid h-8 w-8 place-items-center rounded-full border border-[#E1E5E9] text-[#68717A] transition hover:bg-[#F4F6F8] disabled:cursor-not-allowed disabled:opacity-30"
          aria-label="Previous match panel"
        >
          <ChevronLeft size={15} />
        </button>

        {[0, 1, 2].map((index) => (
          <button
            key={index}
            type="button"
            onClick={() => scrollToSlide(index)}
            className={`h-1.5 rounded-full transition-all duration-300 ${
              slide === index ? 'w-7 bg-[#20242A]' : 'w-1.5 bg-[#D0D5DA]'
            }`}
            aria-label={`Match panel ${index + 1}`}
          />
        ))}

        <button
          type="button"
          onClick={() => scrollToSlide(Math.min(2, slide + 1))}
          disabled={slide === 2}
          className="grid h-8 w-8 place-items-center rounded-full border border-[#E1E5E9] text-[#68717A] transition hover:bg-[#F4F6F8] disabled:cursor-not-allowed disabled:opacity-30"
          aria-label="Next match panel"
        >
          <ChevronRight size={15} />
        </button>
      </div>
    </section>
  );
}
