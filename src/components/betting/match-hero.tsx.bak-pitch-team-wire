  home: MatchView['participants'][number] | undefined;
  away: MatchView['participants'][number] | undefined;
  homeName: string;
  awayName: string;
  liveEvents: Array<{
    id: string;
    minute: number | null;
    type: string;
    playerName: string | null;
    detail: string | null;
  }>;
  liveStats: {
    provider?: string | null;
    updatedAt?: string | null;
    payload?: unknown;
  } | null;
  matchHistory: {
    home: Array<{
      providerId: string;
      scheduledAt: string;
      homeTeam: string;
      awayTeam: string;
      homeScore: number | null;
      awayScore: number | null;
      result: 'W' | 'D' | 'L' | null;
    }>;
    away: Array<{
      providerId: string;
      scheduledAt: string;
      homeTeam: string;
      awayTeam: string;
      homeScore: number | null;
      awayScore: number | null;
      result: 'W' | 'D' | 'L' | null;
    }>;
    h2h: Array<{
      providerId: string;
      scheduledAt: string;
      homeTeam: string;
      awayTeam: string;
      homeScore: number | null;
      awayScore: number | null;
      result: 'W' | 'D' | 'L' | null;
    }>;
  };
}) {
  const sliderRef = useRef<HTMLDivElement>(null);
  const [slide, setSlide] = useState(0);
  const [liveSeconds, setLiveSeconds] = useState(
    match.minute == null ? 0 : Math.max(0, match.minute) * 60,
  );

  useEffect(() => {
    if (!match.isLive || match.minute == null) return;

    setLiveSeconds(Math.max(0, match.minute) * 60);

    const timer = window.setInterval(() => {
      setLiveSeconds((seconds) => seconds + 1);
    }, 1000);

    return () => window.clearInterval(timer);
  }, [match.isLive, match.minute]);

  const statsPayload = liveStats?.payload as {
    statistics?: {
      teams?: Array<{
        teamName?: string;
        statistics?: Array<{
          type?: string;
          value?: string | number | null;
        }>;
      }>;
    };
  } | null;

  const statTeams = statsPayload?.statistics?.teams ?? [];
  const homeStats = statTeams[0];
  const awayStats = statTeams[1];

  const stats = useMemo(() => {
    const possessionHome = statValue(homeStats, 'Possession');
    const possessionAway = statValue(awayStats, 'Possession');

    const attacksHome = statValue(homeStats, 'Attacks');
    const attacksAway = statValue(awayStats, 'Attacks');

    const dangerousHome = statValue(homeStats, 'Dangerous attacks');
    const dangerousAway = statValue(awayStats, 'Dangerous attacks');

    const shotsOnHome = statValue(homeStats, 'Shots on target');
    const shotsOnAway = statValue(awayStats, 'Shots on target');

    const shotsOffHome = statValue(homeStats, 'Shots off target');
    const shotsOffAway = statValue(awayStats, 'Shots off target');

    const cornersHome = statValue(homeStats, 'Corners');
    const cornersAway = statValue(awayStats, 'Corners');

    const yellowHome = statValue(homeStats, 'Yellow cards');
    const yellowAway = statValue(awayStats, 'Yellow cards');

    const redHome = statValue(homeStats, 'Red cards');
    const redAway = statValue(awayStats, 'Red cards');

    const pressureHome = attacksHome + dangerousHome * 1.8 + shotsOnHome * 5;
    const pressureAway = attacksAway + dangerousAway * 1.8 + shotsOnAway * 5;
    const pressureTotal = pressureHome + pressureAway;

    return {
      possessionHome,
      possessionAway,
      attacksHome,
      attacksAway,
      dangerousHome,
      dangerousAway,
      shotsOnHome,
      shotsOnAway,
      shotsOffHome,
      shotsOffAway,
      cornersHome,
      cornersAway,
      yellowHome,
      yellowAway,
      redHome,
      redAway,
      pressureHome,
      pressureAway,
      pressureHomePct:
        pressureTotal > 0 ? Math.round((pressureHome / pressureTotal) * 100) : 50,
      pressureAwayPct:
        pressureTotal > 0 ? Math.round((pressureAway / pressureTotal) * 100) : 50,
    };
  }, [homeStats, awayStats]);

  const latestEvent = liveEvents[liveEvents.length - 1];

    const [freshness, setFreshness] = useState<number | null>(null);

    useEffect(() => {
      if (!liveStats?.updatedAt) {
        setFreshness(null);
        return;
      }

      const updatedAt = liveStats.updatedAt;
      if (!updatedAt) return;

      const updateFreshness = () => {
        const timestamp = new Date(updatedAt).getTime();
        setFreshness(
          Math.max(0, Math.round((Date.now() - timestamp) / 1000)),
        );
      };

      updateFreshness();
      const timer = window.setInterval(updateFreshness, 1000);

      return () => window.clearInterval(timer);
    }, [liveStats?.updatedAt]);

  const scrollToSlide = (index: number) => {
    const container = sliderRef.current;
    if (!container) return;

    container.scrollTo({
      left: index * container.clientWidth,
      behavior: 'smooth',
    });

    setSlide(index);
  };

  useEffect(() => {
    const container = sliderRef.current;
    if (!container) return;

    const handleScroll = () => {
      const width = container.clientWidth;
      if (!width) return;

      setSlide(
        Math.max(0, Math.min(2, Math.round(container.scrollLeft / width))),
      );
    };

    container.addEventListener('scroll', handleScroll, { passive: true });

    return () => container.removeEventListener('scroll', handleScroll);
