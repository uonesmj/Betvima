function formatExactDate(value: string) {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  return new Intl.DateTimeFormat('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'UTC',
    timeZoneName: 'short',
  }).format(date);
}

function TeamLogo({
  url,
  name,
  size = 'normal',
}: {
  url: string | null | undefined;
  name: string;
  size?: 'normal' | 'large';
}) {
  const cls =
    size === 'large'
      ? 'h-[72px] w-[72px] sm:h-[92px] sm:w-[92px]'
      : 'h-[58px] w-[58px] sm:h-[68px] sm:w-[68px]';

  if (!url) {
    return (
      <div
        className={`grid ${cls} shrink-0 place-items-center rounded-full border border-white/15 bg-white/10 text-xl font-black text-white shadow-[0_8px_30px_rgba(0,0,0,.2)]`}
        aria-label={name}
      >
        {name.slice(0, 1).toUpperCase()}
      </div>
    );
  }

  return (
    <div
      className={`grid ${cls} shrink-0 place-items-center rounded-full border border-white/20 bg-white p-2.5 shadow-[0_8px_30px_rgba(0,0,0,.22)]`}
    >
      <img
        src={url}
        alt=""
        className="h-full w-full object-contain"
        loading="eager"
      />
    </div>
  );
}

function toNumber(value: unknown) {
  if (typeof value === 'number' && Number.isFinite(value)) return value;
  if (typeof value === 'string') {
    const n = Number.parseFloat(value.replace('%', '').trim());
    return Number.isFinite(n) ? n : 0;
  }
  return 0;
}

function eventIcon(type: string) {
  const normalized = type.toLowerCase();

  if (normalized.includes('red')) return <ShieldAlert size={14} />;
  if (normalized.includes('yellow')) return <AlertTriangle size={14} />;
  if (normalized.includes('corner')) return <CornerDownRight size={14} />;
  if (normalized.includes('goal')) return <Target size={14} />;
  if (normalized.includes('shot')) return <Target size={14} />;
  if (normalized.includes('period')) return <Flag size={14} />;

  return <Activity size={14} />;
}

function eventLabel(type: string) {
  const value = type.replace(/_/g, ' ').trim();
  return value
    .split(' ')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

function statValue(
  team: { statistics?: Array<{ type?: string; value?: string | number | null }> } | undefined,
  name: string,
) {
  const found = team?.statistics?.find(
    (item) => item.type?.toLowerCase() === name.toLowerCase(),
  );
  return toNumber(found?.value);
}

function StatBar({
  label,
  home,
  away,
  suffix = '',
}: {
  label: string;
  home: number;
  away: number;
  suffix?: string;
}) {
  const total = home + away;
  const homePct = total > 0 ? Math.round((home / total) * 100) : 50;
  const awayPct = total > 0 ? 100 - homePct : 50;

  return (
    <div className="rounded-2xl border border-[#E5E8EC] bg-white p-3.5 sm:p-4">
      <div className="mb-2.5 flex items-center justify-between gap-3">
        <span className="text-[10px] font-black uppercase tracking-[.12em] text-[#737B84]">
          {label}
        </span>
        <span className="text-[9px] font-semibold text-[#A0A6AD]">
          {home}
          {suffix} — {away}
          {suffix}
        </span>
      </div>

      <div className="grid grid-cols-[42px_1fr_42px] items-center gap-2">
        <span className="text-right text-xs font-black text-[#252A30]">
          {home}
          {suffix}
        </span>

        <div className="relative h-2.5 overflow-hidden rounded-full bg-[#EEF0F3]">
          <div
            className="absolute inset-y-0 left-0 rounded-full bg-[#20262D] transition-all duration-700 ease-out"
            style={{ width: `${homePct}%` }}
          />
          <div
            className="absolute inset-y-0 right-0 rounded-full bg-[#9CA3AA] transition-all duration-700 ease-out"
            style={{ width: `${awayPct}%` }}
          />
        </div>

        <span className="text-xs font-black text-[#252A30]">{away}{suffix}</span>
      </div>
    </div>
  );
}

export function MatchHero({
