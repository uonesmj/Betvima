'use client';

import { useCallback, useEffect, useMemo, useState } from 'react';
import Link from 'next/link';
import {
  ChevronDown,
  IdCard,
  Trash2,
  X,
  WalletCards,
  CircleHelp,
  Share2,
} from 'lucide-react';
import { useApp } from '@/components/layout/providers';
import { useBetSlip } from '@/lib/store/betslip';
import { formatMinor, formatOddsScaled } from '@/lib/i18n';
import { ApiClientError, apiRequest } from '@/lib/hooks/useApi';

interface QuoteResponse {
  quote: {
    combinedOddsScaled: string; potentialPayoutMinor: string; warnings: string[];
    oddsChanges: { selectionId: string; previousOddsScaled: string; currentOddsScaled: string; direction: 'UP' | 'DOWN' }[];
    quoteToken: string; expiresAt: string;
  };
}

/**
 * BET SLIP - opens ONLY from the dedicated control (`openFromControl`). The desktop rail
 * and the mobile bottom sheet are the same component tree, so behaviour cannot diverge.
 */

function prettyMarketLabel(value: string) {
  const normalized = value.trim().toLowerCase();

  const labels: Record<string, string> = {
    h2h: 'Match winner',
    h2h_lay: 'Match winner (Lay)',
    totals: 'Total',
    spreads: 'Handicap',
    outrights: 'Outright',
    draw_no_bet: 'Draw no bet',
    btts: 'Both teams to score',
  };

  return labels[normalized] || value.replace(/[_-]+/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}

export function BetSlipRail() {
  const { t, locale, session } = useApp();
  const slip = useBetSlip();
  // Open = the user asked for it from a dedicated control and has not closed it since.
  const visible = useMemo(() => slip.isOpen && !slip.userClosed, [slip.isOpen, slip.userClosed]);

  const [quoteError, setQuoteError] = useState<string | null>(null);
  const [pendingQuote, setPendingQuote] = useState<QuoteResponse['quote'] | null>(null);

  const stake = BigInt(slip.stakeMinor || '0');
  const combinedOdds = useMemo(() => {
    if (slip.items.length === 0) return 0n;
    const numerator = slip.items.reduce((acc, item) => acc * BigInt(item.oddsScaled), 1n);
    const denominator = 10_000n ** BigInt(slip.items.length - 1);
    return numerator / denominator;
  }, [slip.items]);
  const potentialPayout = useMemo(
    () => (combinedOdds * stake) / 10_000n,
    [combinedOdds, stake],
  );

  const place = useCallback(async () => {
    if (!session?.authenticated) {
      window.location.href = '/auth/login';
      return;
    }
    slip.setSubmitting(true);
    setQuoteError(null);
    try {
      const acceptedOdds: Record<string, string> = {};
      if (pendingQuote) {
        for (const change of pendingQuote.oddsChanges) acceptedOdds[change.selectionId] = change.currentOddsScaled;
      }
      const payload = {
        type: slip.items.length > 1 ? 'MULTIPLE' : 'SINGLE',
        stakeMinor: slip.stakeMinor,
        currency: session.user?.currency ?? 'USD',
        legs: slip.items.map((item) => ({
          matchId: item.matchId, marketId: item.marketId, selectionId: item.selectionId,
          clientOddsScaled: item.oddsScaled, marketVersion: item.oddsVersionSeen,
          acceptOddsChange: Boolean(pendingQuote),
        })),
        quoteToken: pendingQuote?.quoteToken ?? null,
        acceptedOdds,
        acceptWarnings: true,
      };
      const result = await apiRequest<{ bet: { publicId: string }; balanceAfterMinor: string }>('/api/v1/bets', {
        method: 'POST', json: payload, idempotencyKey: crypto.randomUUID(),
      });
      slip.setSuccess(t('betslip.accepted'));
      slip.clear();
      setPendingQuote(null);
      window.location.href = `/bets?highlight=${result.bet.publicId}`;
    } catch (error) {
      if (error instanceof ApiClientError && error.code === 'ODDS_CHANGED') {
        const details = error.details as { oddsChanges?: QuoteResponse['quote']['oddsChanges']; quoteToken?: string; potentialPayoutMinor?: string; combinedOddsScaled?: string } | undefined;
        setPendingQuote({
          combinedOddsScaled: details?.combinedOddsScaled ?? '0',
          potentialPayoutMinor: details?.potentialPayoutMinor ?? '0',
          warnings: [t('betslip.oddsChanged')],
          oddsChanges: details?.oddsChanges ?? [],
          quoteToken: details?.quoteToken ?? '',
          expiresAt: new Date(Date.now() + 60_000).toISOString(),
        });
        setQuoteError(t('betslip.oddsChanged'));
      } else if (error instanceof ApiClientError) {
        setQuoteError(error.message);
        slip.setError(error.message);
      } else {
        setQuoteError(t('common.error'));
        slip.setError(t('common.error'));
      }
      slip.setSubmitting(false);
    }
  }, [pendingQuote, session, slip, t]);

  if (!visible) {
    if (!slip.isOpen) return null;
  }

  // The mobile sheet renders whenever the slip is open - an empty slip shows its own empty
  // state instead of the control appearing to do nothing on a phone.
  const isMobileSheet = slip.isOpen;

  return (
    <>
      {/* Desktop rail */}
      <aside
        className="nova-betslip-rail fixed end-0 top-14 z-40 hidden h-[calc(100dvh-56px)] w-[370px] overflow-y-auto border-s border-[#E2E4E8] bg-white p-3 shadow-[-8px_0_30px_rgba(0,0,0,.06)] md:block"
        aria-label={t('betslip.title')} data-testid="betslip-rail" data-betslip-panel="rail"
      >
        <BetSlipBody
          quoteError={quoteError} pendingQuote={pendingQuote} combinedOdds={combinedOdds} potentialPayout={potentialPayout}
          onPlace={place} onDismissQuote={() => { setPendingQuote(null); setQuoteError(null); }}
        />
      </aside>

      {/* Mobile bottom sheet */}
      {isMobileSheet ? (
        <>
          <div
            className="fixed inset-0 bottom-[52px] z-40 bg-black/65 backdrop-blur-[1.5px] md:hidden"
            aria-hidden="true"
            onClick={() => slip.close()}
          />
          <div
            className="nova-betslip-sheet fixed inset-x-0 bottom-[52px] z-50 md:hidden"
            data-testid="betslip-sheet"
            data-betslip-panel="sheet"
            aria-label={t('betslip.title')}
          >
            <div className="max-h-[86dvh] overflow-y-auto rounded-t-[26px] border-t border-[#E1E3E7] bg-white px-3 pb-4 shadow-[0_-18px_50px_rgba(0,0,0,.28)]">
              <BetSlipBody
                quoteError={quoteError}
                pendingQuote={pendingQuote}
                combinedOdds={combinedOdds}
                potentialPayout={potentialPayout}
                onPlace={place}
                onDismissQuote={() => {
                  setPendingQuote(null);
                  setQuoteError(null);
                }}
              />
            </div>
          </div>
        </>
      ) : null}
    </>
  );
}

function BetSlipBody({
  quoteError, pendingQuote, combinedOdds, potentialPayout, onPlace, onDismissQuote,
}: {
  quoteError: string | null;
  pendingQuote: QuoteResponse['quote'] | null;
  combinedOdds: bigint;
  potentialPayout: bigint;
  onPlace: () => void;
  onDismissQuote: () => void;
}) {
  const { t, locale, session } = useApp();
  const slip = useBetSlip();
  const currency = session?.user?.currency ?? 'USD';
  const [balanceMinor, setBalanceMinor] = useState<string | null>(null);
  const [balanceLoading, setBalanceLoading] = useState(false);
  const [viewMode, setViewMode] = useState<'SINGLE' | 'MULTIPLE' | 'SERIES'>(slip.mode);
  const [betCode, setBetCode] = useState('');

  const loadBalance = useCallback(async () => {
    if (!session?.authenticated || !session.user?.currency) {
      setBalanceMinor(null);
      return;
    }
    setBalanceLoading(true);
    try {
      const result = await apiRequest<{
        wallet: {
          balanceMinor: string | number | bigint;
        };
      }>(
        `/api/v1/wallet?currency=${encodeURIComponent(session.user.currency)}`,
        { method: 'GET' },
      );
      setBalanceMinor(String(result.wallet.balanceMinor));
    } catch {
      setBalanceMinor(null);
    } finally {
      setBalanceLoading(false);
    }
  }, [session?.authenticated, session?.user?.currency]);

  useEffect(() => {
    void loadBalance();
    if (!session?.authenticated) return;
    const interval = window.setInterval(() => {
      void loadBalance();
    }, 15000);
    return () => window.clearInterval(interval);
  }, [loadBalance, session?.authenticated]);

  useEffect(() => {
    if (slip.mode !== 'SINGLE' && slip.mode !== 'MULTIPLE') return;
    setViewMode(slip.mode);
  }, [slip.mode]);

  const selectMode = (mode: 'SINGLE' | 'MULTIPLE' | 'SERIES') => {
    setViewMode(mode);
    if (mode === 'SINGLE' || mode === 'MULTIPLE') {
      slip.setMode(mode);
    }
  };

  const bonusTarget = 5;
  const bonusRemaining = Math.max(0, bonusTarget - slip.items.length);
  const bonusPercent = Math.min(100, (slip.items.length / bonusTarget) * 100);
  const showBonus = viewMode === 'MULTIPLE' && slip.items.length > 0;

  return (
    <div className="text-[#15171B]">
      {/* Header */}
      <div className="sticky top-0 z-10 -mx-3 flex h-[58px] items-center justify-between border-b border-[#E4E6EA] bg-[#F3F4F7] px-4">
        <button
          type="button"
          onClick={() => slip.close()}
          className="flex items-center gap-2 text-[17px] font-extrabold text-[#17191D]"
          aria-label={t('betslip.close')}
          data-testid="betslip-close"
        >
          <ChevronDown className="h-6 w-6" strokeWidth={2.5} />
          <span>{t('betslip.title')}</span>
        </button>

        <div className="flex items-center gap-2">
          {session?.authenticated ? (
            <div className="flex items-center gap-1.5 text-[15px] font-extrabold text-[#202329]">
              <WalletCards className="h-[19px] w-[19px] text-[#7D8795]" strokeWidth={2} />
              <span>
                {currency} {balanceLoading && balanceMinor === null
                  ? '0.00'
                  : balanceMinor !== null
                    ? formatMinor(balanceMinor, currency, locale)
                    : '0.00'}
              </span>
            </div>
          ) : null}
        </div>
      </div>

      {/* Body */}
      <div className="space-y-3 pt-3">
        {slip.items.length === 0 ? (
          <div className="flex min-h-[290px] flex-col items-center justify-center px-3 pb-2 text-center">
            <div className="mb-5 grid h-16 w-16 place-items-center rounded-full bg-[#EAF2FF]">
              <IdCard className="h-9 w-9 text-[#147BEF]" strokeWidth={2} />
            </div>

            <h3 className="max-w-[260px] text-[23px] font-extrabold leading-tight text-[#15171B]">
              Select an outcome
              <br />
              to place a bet
            </h3>

            <div className="mt-9 flex w-full items-center gap-3">
              <input
                value={betCode}
                onChange={(event) => setBetCode(event.target.value)}
                placeholder="Bet code"
                aria-label="Bet code"
                className="h-[54px] min-w-0 flex-1 rounded-[17px] border border-[#E1E4E9] bg-[#F0F1F4] px-4 text-[16px] font-medium text-[#202329] outline-none transition focus:border-[#1481F2] focus:bg-white"
              />
              <button
                type="button"
                disabled={!betCode.trim()}
                className="h-[54px] rounded-[17px] bg-[#71D6A4] px-6 text-[16px] font-extrabold text-white transition disabled:cursor-not-allowed disabled:opacity-50"
              >
                View bet
              </button>
            </div>
          </div>
        ) : (
          <>
            {/* Selection tabs */}
            <div className="flex items-center gap-3">
              <div className="grid flex-1 grid-cols-3 rounded-[17px] bg-[#ECEEF2] p-1">
                {([
                  ['SINGLE', 'Single'],
                  ['MULTIPLE', 'Multiple'],
                  ['SERIES', 'Series'],
                ] as const).map(([mode, label]) => (
                  <button
                    key={mode}
                    type="button"
                    onClick={() => selectMode(mode)}
                    className={`h-[48px] rounded-[14px] text-[16px] font-bold transition ${
                      viewMode === mode
                        ? 'bg-[#1684F5] text-white shadow-[0_2px_5px_rgba(0,0,0,.14)]'
                        : 'text-[#202329]'
                    }`}
                    aria-pressed={viewMode === mode}
                  >
                    {label}
                  </button>
                ))}
              </div>

              <button
                type="button"
                onClick={() => slip.clear()}
                aria-label={t('betslip.clear')}
                className="grid h-[56px] w-[58px] shrink-0 place-items-center rounded-[17px] bg-[#ECEEF2] text-[#858D99] transition hover:bg-[#E4E6EA] hover:text-[#535B67]"
              >
                <Trash2 className="h-6 w-6" strokeWidth={2.1} />
              </button>
            </div>

            {/* Selection cards */}
            <ul className="space-y-2.5">
              {slip.items.map((item) => {
                const change = pendingQuote?.oddsChanges.find(
                  (c) => c.selectionId === item.selectionId,
                );

                return (
                  <li
                    key={item.selectionId}
                    className="rounded-[18px] border border-[#E5E7EB] bg-[#F3F4F6] px-4 py-3 shadow-[0_1px_2px_rgba(0,0,0,.03)]"
                  >
                    <div className="flex items-start gap-3">
                      <div className="min-w-0 flex-1">
                        <div className="flex items-center gap-2">
                          <span className="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-[#F2E9FF] text-[10px] font-black text-[#D0008B]">
                            •
                          </span>
                          <span className="text-[15px] font-bold text-[#4B515B]">
                            {item.matchLabel}
                          </span>
                        </div>

                        <div className="mt-3 truncate text-[16px] font-extrabold text-[#181A1E]">
                          {prettyMarketLabel(item.marketLabel)} · {item.label}
                        </div>
                      </div>

                      <div className="flex shrink-0 items-start gap-2">
                        {change ? (
                          <div
                            className="flex flex-col items-end"
                            data-testid="odds-change"
                          >
                            <span className="text-[12px] font-semibold text-[#8A919C] line-through">
                              {formatOddsScaled(change.previousOddsScaled)}
                            </span>
                            <span
                              className={`rounded-[11px] px-3 py-1.5 text-[16px] font-extrabold text-white ${
                                change.direction === 'UP'
                                  ? 'bg-[#1684F5]'
                                  : 'bg-[#E94B5F]'
                              }`}
                            >
                              {formatOddsScaled(change.currentOddsScaled)}
                            </span>
                          </div>
                        ) : (
                          <span className="rounded-[11px] bg-[#1684F5] px-3.5 py-1.5 text-[16px] font-extrabold text-white">
                            {formatOddsScaled(item.oddsScaled)}
                          </span>
                        )}

                        <button
                          type="button"
                          onClick={() => slip.remove(item.selectionId)}
                          aria-label={t('betslip.remove')}
                          className="mt-0.5 grid h-7 w-7 place-items-center text-[#6F7680] transition hover:text-[#E44B5D]"
                        >
                          <X className="h-5 w-5" strokeWidth={2.4} />
                        </button>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>

            {/* Multiple bonus preview */}
            {showBonus ? (
              <div className="rounded-[18px] border border-[#BCE8D4] bg-[#F2FFF8] p-4">
                <div className="text-[14px] font-semibold text-[#68716D]">
                  {bonusRemaining > 0
                    ? `Add ${bonusRemaining} more event${bonusRemaining === 1 ? '' : 's'} to get a 7% win bonus`
                    : '7% win bonus target reached'}
                </div>

                <div className="mt-3 h-2.5 overflow-hidden rounded-full bg-[#E1E8E5]">
                  <div
                    className="h-full rounded-full bg-[#22C7C8] transition-all duration-300"
                    style={{ width: `${bonusPercent}%` }}
                  />
                </div>

                <div className="mt-2 flex justify-between text-[11px] font-semibold text-[#727A77]">
                  <span>0%</span>
                  <span>7%</span>
                  <span>9%</span>
                  <span>10%</span>
                  <span>12%</span>
                  <span>15%</span>
                </div>

                <div className="mt-3 flex items-center justify-between">
                  <span className="flex items-center gap-1.5 text-[15px] font-extrabold text-[#252A27]">
                    Bonus
                    <CircleHelp className="h-4 w-4 text-[#7E8984]" />
                  </span>
                  <span className="text-[15px] font-extrabold text-[#159A62]">
                    0% = {currency} 0.00
                  </span>
                </div>
              </div>
            ) : null}

            {/* Bet amount */}
            {viewMode !== 'SERIES' || slip.items.length > 0 ? (
              <div className="space-y-2">
                <div className="relative">
                  <label
                    htmlFor="betslip-stake"
                    className="sr-only"
                  >
                    {t('betslip.stake')}
                  </label>
                  <input
                    id="betslip-stake"
                    inputMode="numeric"
                    value={slip.stakeMinor}
                    onChange={(event) => slip.setStake(event.target.value)}
                    placeholder="Bet amount"
                    className="h-[58px] w-full rounded-[18px] border border-[#E1E4E9] bg-[#F0F1F4] px-4 pr-20 text-[16px] font-medium text-[#202329] outline-none transition focus:border-[#1684F5] focus:bg-white"
                  />
                  <button
                    type="button"
                    onClick={() => {
                      if (balanceMinor !== null) slip.setStake(balanceMinor);
                    }}
                    disabled={balanceMinor === null}
                    className="absolute inset-y-0 end-0 px-5 text-[17px] font-extrabold text-[#1684F5] disabled:opacity-40"
                  >
                    MAX
                  </button>
                </div>

                <div className="flex flex-wrap gap-1.5">
                  {['10000', '50000', '100000', '500000', '1000000'].map((value) => (
                    <button
                      key={value}
                      type="button"
                      onClick={() => slip.setStake(value)}
                      className="rounded-full bg-[#EEF0F3] px-3 py-1.5 text-[11px] font-bold text-[#68707B] transition hover:bg-[#E2E5E9]"
                    >
                      {formatMinor(BigInt(value), currency, locale)}
                    </button>
                  ))}
                </div>
              </div>
            ) : null}

            {/* Totals */}
            <div className="space-y-2 px-1">
              <div className="flex items-center justify-between">
                <span className="text-[15px] font-medium text-[#707781]">
                  {t('betslip.totalOdds')}
                </span>
                <span className="text-[16px] font-extrabold text-[#202329]">
                  {formatOddsScaled(combinedOdds)}
                </span>
              </div>

              <div className="flex items-center justify-between">
                <span className="text-[15px] font-medium text-[#707781]">
                  Possible win
                </span>
                <span className="text-[16px] font-extrabold text-[#159A62]">
                  {formatMinor(potentialPayout, currency, locale)}
                </span>
              </div>
            </div>

            {/* Odds change warning */}
            {quoteError ? (
              <div className="rounded-[17px] border border-[#F0D78B] bg-[#FFF9E8] p-3.5">
                <div className="text-[14px] font-extrabold text-[#8A6911]">
                  {t('betslip.oddsChanged')}
                </div>

                <button
                  type="button"
                  onClick={onPlace}
                  className="mt-3 h-12 w-full rounded-[15px] bg-[#1684F5] text-[15px] font-extrabold text-white"
                >
                  {t('betslip.acceptNewOdds')}
                </button>

                <button
                  type="button"
                  onClick={onDismissQuote}
                  className="mt-2 w-full text-[12px] font-bold text-[#777D85]"
                >
                  {t('common.cancel')}
                </button>
              </div>
            ) : (
              <div className="flex items-center gap-2">
                <button
                  type="button"
                  aria-label="Share bet slip"
                  className="grid h-[56px] w-[62px] shrink-0 place-items-center rounded-[17px] bg-[#EEF0F3] text-[#8A929D]"
                >
                  <Share2 className="h-6 w-6" strokeWidth={2} />
                </button>

                <button
                  type="button"
                  onClick={onPlace}
                  disabled={
                    slip.isSubmitting ||
                    BigInt(slip.stakeMinor || '0') <= 0n
                  }
                  data-testid="betslip-place"
                  className="h-[56px] flex-1 rounded-[17px] bg-[#08B94E] text-[17px] font-extrabold text-white shadow-[0_4px_10px_rgba(8,185,78,.18)] transition hover:bg-[#06AA47] disabled:cursor-not-allowed disabled:opacity-45"
                >
                  {slip.isSubmitting ? t('common.loading') : 'Place a bet'}
                </button>
              </div>
            )}

            {!session?.authenticated ? (
              <p className="pb-1 text-center text-[12px] font-medium text-[#727983]">
                <Link
                  href="/auth/login"
                  className="font-extrabold text-[#1684F5]"
                >
                  {t('nav.login')}
                </Link>
              </p>
            ) : null}
          </>
        )}
      </div>
    </div>
  );
}
