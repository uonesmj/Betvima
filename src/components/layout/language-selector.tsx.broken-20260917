export function LanguageSelector() {
  const { locale, setLocale } = useApp();
  const current = LANGUAGES.find((item) => item.locale === locale) ?? LANGUAGES[0];

  return (
    <label className="relative inline-flex items-center">
      <span className="sr-only">Language</span>
      <span className="mr-2 text-sm">{current.flag}</span>
      <select
        value={locale}
        onChange={(event) => setLocale(event.target.value as Locale)}
        className="h-9 max-w-[150px] rounded-lg border border-white/10 bg-white/5 px-2 text-sm text-white outline-none transition hover:bg-white/10 focus:border-sky-400/50"
        aria-label="Language"
      >
        {LANGUAGES.map((item) => (
          <option key={item.locale} value={item.locale} className="bg-[#0b1020] text-white">
            {item.flag} {item.nativeName}
          </option>
        ))}
      </select>
    </label>
  );
}
